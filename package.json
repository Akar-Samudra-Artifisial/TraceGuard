{
  "name": "traceguard",
  "version": "0.1.0",
  "private": true,
  "description": "Live, audit-ready traceability for regulated software on Atlassian Forge",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui",
