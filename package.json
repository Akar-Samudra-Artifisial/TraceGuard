    "lint": "forge lint",
    "deploy": "npm run build:ui && forge deploy"
  },
  "dependencies": {
    "@forge/api": "^8.4.0",
    "@forge/kvs": "^2.1.1",
    "@forge/resolver": "^2.0.2"
  },
  "devDependencies": {
    "@forge/bridge": "^7.2.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
